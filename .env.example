# ==========================================================================
# QA Management Platform - Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# All variables are validated at runtime by src/lib/env.ts (fail-fast).
# ==========================================================================

# --- Database (Neon PostgreSQL or any Postgres) ---------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional direct (unpooled) connection for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# --- Better Auth ----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (file attachments) ---------------------------------------
# Optional locally; required for uploads in production.
BLOB_READ_WRITE_TOKEN=""

# --- Email transport ------------------------------------------------------
# Emails (member invitations, verification, password reset) are sent via the
# first configured transport: SMTP > Resend > console (dev fallback).
#
# Option A — SMTP (e.g. Gmail). Create an App Password at
#   https://myaccount.google.com/apppasswords (requires 2-Step Verification),
#   then paste it as SMTP_PASSWORD with NO spaces. NEVER commit real values.
SMTP_HOST=""              # e.g. smtp.gmail.com
SMTP_PORT="587"           # 587 (STARTTLS) or 465 (SMTP_SECURE=true)
SMTP_USER=""              # your full Gmail address
SMTP_PASSWORD=""          # the 16-char app password, no spaces
SMTP_SECURE="false"       # "true" only for port 465
#
# Option B — Resend. Optional. When absent (and no SMTP), emails are logged.
RESEND_API_KEY=""
#
# The From header for all outbound email. For Gmail SMTP this MUST be your
# own Gmail address, e.g. "QA Platform <youraddress@gmail.com>".
EMAIL_FROM="QA Platform <no-reply@example.com>"

# --- Integrations / CI webhooks -------------------------------------------
# Secret used to sign & verify inbound CI/CD test-result webhooks (HMAC).
INTEGRATION_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"

# --- Runtime --------------------------------------------------------------
NODE_ENV="development"
# Set to "true" to allow the seed script to run.
ALLOW_SEED="true"
LOG_LEVEL="info"
