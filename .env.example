# ==========================================================================
# QA Management Platform - Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# All variables are validated at runtime by src/lib/env.ts (fail-fast).
# ==========================================================================

# --- Database (Neon PostgreSQL or any Postgres) ---------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Optional direct (unpooled) connection for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# --- Better Auth ----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (file attachments) ---------------------------------------
# Optional locally; required for uploads in production.
BLOB_READ_WRITE_TOKEN=""

# --- Resend (transactional email) -----------------------------------------
# Optional. When absent, emails are logged to the console (dev mode).
RESEND_API_KEY=""
EMAIL_FROM="QA Platform <no-reply@example.com>"

# --- Integrations / CI webhooks -------------------------------------------
# Secret used to sign & verify inbound CI/CD test-result webhooks (HMAC).
INTEGRATION_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"

# --- Runtime --------------------------------------------------------------
NODE_ENV="development"
# Set to "true" to allow the seed script to run.
ALLOW_SEED="true"
LOG_LEVEL="info"
